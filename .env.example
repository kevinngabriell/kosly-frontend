# Copy to .env.local and adjust. .env.local is git-ignored; this file is committed with placeholders only.

# Base URL of the Kosly API, no trailing slash. Read once by src/lib/api-client.ts.
# Empty string = same origin (what you want when using the built-in mock API below).
# Anything else must be https:// outside local development.
NEXT_PUBLIC_API_BASE_URL=

# Origin used for canonical URLs, hreflang, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# DEV ONLY. Serves an in-memory fake of the Kosly API at /api/v1/* (see docs/mock-accounts.md).
# Server-only on purpose (no NEXT_PUBLIC_ prefix). Never set this in staging or production:
# the mock accounts share one well-known password.
KOSLY_MOCK_API=false
